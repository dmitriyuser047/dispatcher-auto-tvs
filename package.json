{
  "name": "dispetcherizaciya-avto",
  "version": "3.0.0",
  "description": "Диспетчеризация авто группы компаний ООО Технрайз Велл Сервис",
  "author": "ООО Технрайз Велл Сервис",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node --test tests/ui-regression.cjs",
    "test:electron": "node --test tests/electron-smoke.cjs",
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tvs.dispetcherizaciya-avto",
    "productName": "Диспетчеризация авто ООО Технрайз Велл Сервис",
    "artifactName": "Dispatcher-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "vendor/**",
      "ReestrBuilder/lib.mjs",
      "ReestrBuilder/archive-safety.mjs",
      "ReestrBuilder/config.json",
      "ReestrBuilder/statyi.json",
      "rus.traineddata",
      "eng.traineddata",
      "assets/**",
      "index.html",
      "reestr-window.html",
      "pdf-editor.html",
      "ReestrBuilder/contracts.json",
      "bundled-data/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-unrar-js/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {},
  "dependencies": {
    "adm-zip": "0.6.1",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
