{
  "name": "dispetcherizaciya-avto",
  "version": "3.5.5",
  "author": "ООО Технрайз Велл Сервис",
  "description": "Диспетчеризация авто группы компаний ООО Технрайз Велл Сервис",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node --test --test-concurrency=2 tests/ui-regression.cjs tests/unified-ui.cjs tests/cost-accounting-ui.cjs tests/procurement-ui.cjs tests/engine-integration-ui.cjs tests/writeoff-workflow-ui.cjs",
    "test:engine": "node --test tests/dispatcher-core.test.cjs tests/fuel-engine.test.cjs tests/fuel-records-query.test.cjs tests/writeoff-engine.test.cjs",
    "engine:demo": "node scripts/engine-demo.cjs",
    "test:electron": "node --test tests/unified-electron.cjs",
    "start": "electron .",
    "build": "node scripts/build-installer.cjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tvs.dispetcherizaciya-avto",
    "productName": "Диспетчеризация авто ООО Технрайз Велл Сервис",
    "artifactName": "Dispatcher-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "vendor/**",
      "ReestrBuilder/lib.mjs",
      "ReestrBuilder/config.json",
      "ReestrBuilder/statyi.json",
      "rus.traineddata",
      "eng.traineddata",
      "assets/**",
      "index.html",
      "reestr-window.html",
      "pdf-editor.html",
      "ReestrBuilder/contracts.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-unrar-js/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@embedpdf/pdfium/**",
      "node_modules/@napi-rs/**",
      "vendor/tesseract-worker/**",
      "vendor/tesseract-core/**",
      "assets/ocr/models/**",
      "assets/ocr/models-manifest.json",
      "electron/pdf-content-engine.cjs",
      "rus.traineddata",
      "eng.traineddata"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "guid": "4286bdd0-2cff-53b2-b57c-c2a89b587631",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {},
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@napi-rs/canvas": "1.0.11",
    "@pdf-lib/fontkit": "^1.1.1",
    "adm-zip": "0.6.1",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
