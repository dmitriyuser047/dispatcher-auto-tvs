{
  "compilerOptions": {
    "target": "ES2020",
    "module": "amd",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outFile": ".typed-application/application.js",
    "newLine": "lf"
  },
  "files": [
    "src/application/contracts.ts",
    "src/application/repository.ts",
    "src/application/save-service.ts",
    "src/application/row-commands.ts",
    "src/application/card-controller.ts",
    "src/features/maintenance-setup/model.ts",
    "src/features/maintenance-setup/view.ts",
    "src/features/maintenance-setup/controller.ts",
    "src/application/index.ts"
  ]
}
