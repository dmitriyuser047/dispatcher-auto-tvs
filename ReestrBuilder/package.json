{
  "name": "reestr-builder",
  "version": "2.0.2",
  "description": "Сборка реестра на оплату из архива со счетами и УПД",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server.mjs",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tvs.reestr-builder",
    "productName": "Реестр-Билдер",
    "artifactName": "ReestrBuilder-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/node-unrar-js/**"
    ],
    "files": [
      "electron/**",
      "public/**",
      "lib.mjs",
      "archive-safety.mjs",
      "config.json",
      "statyi.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": { "uuid": "^11.1.1" }
}
