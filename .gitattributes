# Preserve document fixtures and runtime assets byte-for-byte on Windows.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.wasm binary
*.traineddata binary

# These checked-in OCR files are verified against byte-level manifests.
# Git's Windows newline conversion would invalidate their recorded hashes.
/vendor/tesseract-worker/** -text
/vendor/tesseract-core/** -text
/assets/ocr/models-manifest.json -text
/assets/ocr/LICENSE-tessdata_best.txt text eol=lf
/scripts/ocr-native/patches/** text eol=lf

# Frozen print runtime participates in byte-level compatibility fixtures.
/tests/fixtures/document-print-v1-before-v5.cjs -text
/tests/fixtures/schema-v4/** -text
/tests/fixtures/schema-v5/** -text
/tests/fixtures/request-fingerprint-v3.5.8/** -text
